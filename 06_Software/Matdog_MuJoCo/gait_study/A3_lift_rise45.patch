+// Vertical swing profile (gait study, MuJoCo dev.7 correlation 2026-11-12): the foot
+// rises with a smootherstep over the first kSwingLiftRise of the swing and lands with
+// one over the last kSwingLiftFall, at liftM between (C2: zero speed and acceleration
+// at lift-off and touchdown). The legacy bell 64 u^3 (1-u)^3 reaches 5 % of liftM at
+// u = 0.1 and 26 % at u = 0.2, while the foot already moves; a short rise lifts it
+// before it travels, a long fall keeps the touchdown as low as the legacy bell
+// (front UPPER at its kHeight bound). Rise/fall <= 0 keeps the legacy bell.
+constexpr double kSwingLiftRise=0.45,kSwingLiftFall=0.45;
+template<class T> T liftProfile(T u){
+  if(kSwingLiftRise<=0||kSwingLiftFall<=0)return T(64)*u*u*u*(T(1)-u)*(T(1)-u)*(T(1)-u);
+  const T up=pv(u)<kSwingLiftRise?smooth(u*T(1/kSwingLiftRise)):T(1);
+  const T down=pv(u)>1-kSwingLiftFall?smooth((T(1)-u)*T(1/kSwingLiftFall)):T(1);
+  return up*down;
+}
