+// Vertical swing profile (gait study, MuJoCo dev.7 correlation 2026-11-12): with
+// kSwingLiftRise > 0 the foot rises with a smootherstep over the first and lands with
+// one over the last kSwingLiftRise of the swing, at liftM between (C2: zero speed and
+// acceleration at lift-off and touchdown). The legacy bell 64 u^3 (1-u)^3 is at 26 %
+// of liftM at u = 0.2 and 0.8, while the foot travels. STUDY ONLY, WALK STANDARD law
+// alone (duty .825 with the 8 mm lift): FAST (6 mm, 105 mm, 80 mm stride) left the
+// workspace with it (WALK_IK_OR_WORKSPACE) and SLOW lost STOP settling in the twin.
+// A firmware version would carry the choice as a GaitParameters field set per mode.
+constexpr double kSwingLiftRise=.35;
+template<class T> T liftProfile(T u,const GaitParameters& p){
+  const bool flat=kSwingLiftRise>0&&p.liftM>.007&&p.duty>.81;
+  if(!flat)return T(64)*u*u*u*(T(1)-u)*(T(1)-u)*(T(1)-u);
+  const T up=pv(u)<kSwingLiftRise?smooth(u*T(1/kSwingLiftRise)):T(1);
+  const T down=pv(u)>1-kSwingLiftRise?smooth((T(1)-u)*T(1/kSwingLiftRise)):T(1);
+  return up*down;
+}
 // Geometric stride law: body progress, in cycles of advance. Identity without
 // ramps. The start raises the progress rate 0->1 over startCycles; after the
 // decel cycle S=terminal-stopCycles the rate falls 1->0 at the terminal
