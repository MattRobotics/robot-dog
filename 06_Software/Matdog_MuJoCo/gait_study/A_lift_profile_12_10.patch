+// Vertical swing profile (gait study, MuJoCo dev.7 correlation 2026-11-12):
+// kSwingLiftRise > 0 lifts the foot with a smootherstep over the first and
+// lowers it over the last kSwingLiftRise of the swing, flat at liftM between
+// (C2, zero speed and acceleration at lift-off and touchdown); 0 keeps the
+// legacy bell 64 u^3 (1-u)^3, which reaches only 26 % of liftM at u = 0.2.
+#ifndef MATDOG_SWING_LIFT_RISE
+#define MATDOG_SWING_LIFT_RISE 0.35
+#endif
+constexpr double kSwingLiftRise=MATDOG_SWING_LIFT_RISE;
+template<class T> T liftProfile(T u){
+  if(kSwingLiftRise<=0)return T(64)*u*u*u*(T(1)-u)*(T(1)-u)*(T(1)-u);
+  const T up=pv(u)<kSwingLiftRise?smooth(u*T(1/kSwingLiftRise)):T(1);
+  const T down=pv(u)>1-kSwingLiftRise?smooth((T(1)-u)*T(1/kSwingLiftRise)):T(1);
+  return up*down;
+}
