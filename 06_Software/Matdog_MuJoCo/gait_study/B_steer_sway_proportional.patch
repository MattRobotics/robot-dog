diff -ru a/05_Firmware/MATDOG_Controller/src/simple/SimpleMotion.h e/05_Firmware/MATDOG_Controller/src/simple/SimpleMotion.h
--- a/05_Firmware/MATDOG_Controller/src/simple/SimpleMotion.h	2026-11-11 19:04:50.000000000 +0100
+++ e/05_Firmware/MATDOG_Controller/src/simple/SimpleMotion.h	2026-11-12 09:07:34.187576573 +0100
@@ -111,9 +111,18 @@
 // --reverse PASS (HIP margin 10.3 / 12.3 / 13.3 ticks). decelCycles: the forward joystick decrease
 // (kJoystickFrontalDecelCycles below; FAST 3: frontal_changes -0.44 mm with 2).
 struct JoystickSpec { double backM,strideM,lateralM,yawRad,swayBaseYM,swayLowM,swayYM,backSwayYM,decelCycles; };
+// Gait study (MuJoCo dev.7 correlation, 2026-11-12): above the on-demand threshold
+// the steered sway grows with the demand, from kJoystickSwayLowM at the threshold
+// to swayYM at the full lateral/yaw ellipsoid, instead of taking swayYM at once
+// (a 40 % diagonal took the full 9 mm). Below it, unchanged. Hysteresis unchanged:
+// once above the low sway the amplitude never falls under swayLowM until the demand
+// falls under kJoystickSwayOffDemand.
 inline double joystickSwayYM(double advanceYM,double yawRad,double currentSwayYM,const JoystickSpec& j){
   const double y=advanceYM/j.lateralM,w=yawRad/j.yawRad,s=std::sqrt(y*y+w*w);
-  if(s>=(currentSwayYM>j.swayLowM?kJoystickSwayOffDemand:kJoystickSwayOnDemand))return j.swayYM;
+  if(s>=(currentSwayYM>j.swayLowM?kJoystickSwayOffDemand:kJoystickSwayOnDemand)){
+    const double u=std::fmin(1.,std::fmax(0.,(s-kJoystickSwayOnDemand)/(1-kJoystickSwayOnDemand)));
+    return std::fmax(j.swayLowM,j.swayLowM+(j.swayYM-j.swayLowM)*u);
+  }
   return j.swayBaseYM+(j.swayLowM-j.swayBaseYM)*std::fmin(1.,s/kJoystickSwayOnDemand);
 }
 constexpr uint64_t kJoystickTimeoutUs=1000000;
