<!-- MATDOG MESH UNIT CONVENTION | STL vertex coordinates are exported from CAD in millimetres. Every visual and collision mesh applies scale="0.001 0.001 0.001" so the URDF remains SI-consistent: joint origins and CoM are metres; mass is kg; inertia is kg·m². -->
<robot name="matt_robodog_rev00">
  <!-- MATDOG DYNAMIC PROPERTIES REV01-FIX | 17-link CAD nominal mass: 2.928 kg (Solid Edge assembly report: 2.937 kg; the 9 g difference is the 1 g resolution of the per-link mass reports, the 17 link volumes close on the assembly volume within 1.1 mm3) | Single nominal configuration INCLUDING the Jetson Orin (175 g, inside base_link). The robot weighed on 2026-10-30 (2.807 kg) did not carry the Jetson: it is historical evidence, not a second configuration. Standard URDF <inertial> blocks come from Solid Edge physical-property reports of 2026-10-30; CoM origins are in each local link frame; inertia tensors are about those CoMs, in link axes, reconstructed from principal axes + radii of gyration. No hardware dynamic validation. Provenance: 09_Logs/Validation_Reports/REV01_FIX_Physical_Properties_2026-10-31/ and Coordinate_Cinematiche_matt_robodog_rev00.xlsx / Inertial_Properties. -->
  <link name="base_link">
    <!-- MATDOG_DYNAMIC_PROPERTIES | mass_kg=1.828000 | coM_frame=local_link | tensor_frame=local_link_at_com | method=CAD direct: principal axes + radii of gyration | source=base_link__physprop.txt (Solid Edge 2026-10-30, nominal configuration incl. Jetson Orin) -->
    <inertial>
      <origin xyz="-0.00693 -0.00044 0.03657" rpy="0 0 0" />
      <mass value="1.828000" />
      <inertia ixx="0.00188547125067" ixy="-1.42614690873e-05" ixz="-0.000255990774032" iyy="0.0136083325749" iyz="-1.15982178242e-05" izz="0.0140540124868" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/collision/base_link.stl"  scale="0.001 0.001 0.001" />
      </geometry>
      <material name="base_link_mat">
        <color rgba="0.10 0.10 0.10 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/collision/base_link.stl"  scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
