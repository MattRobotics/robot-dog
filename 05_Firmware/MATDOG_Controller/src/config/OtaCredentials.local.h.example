// MATDOG Controller — local OTA shared-secret TEMPLATE.
//
// Copy this file to:
//
//     src/config/OtaCredentials.local.h
//
// and fill in a long, random secret — this is an HMAC-SHA256 key, not a
// human-memorable password. Generate one with e.g.:
//
//     openssl rand -hex 32
//
// and paste the result as the string value below. The copy is gitignored
// and must never be committed; this template is committed and must never
// contain a real secret.
//
//     cp src/config/OtaCredentials.local.h.example \
//        src/config/OtaCredentials.local.h
//
// With no such file the firmware still builds and boots — OTA updates are
// simply refused (OtaSession::authenticate() -> REJECTED_NO_SECRET for
// every request), exactly like an absent Wi-Fi SSID leaves the radio off.
//
// This is a SEPARATE secret from WifiCredentials.local.h's Wi-Fi password,
// deliberately: the two protect different things.
//
// The #ifndef guard lets a -DMATDOG_OTA_SECRET build flag take precedence
// (see src/config/OtaCredentials.h for the full resolution order).

#ifndef MATDOG_OTA_SECRET
#define MATDOG_OTA_SECRET "REPLACE_WITH_A_LONG_RANDOM_SECRET_FROM_OPENSSL_RAND_HEX_32"
#endif
