// MATDOG Controller — local Wi-Fi credentials TEMPLATE.
//
// Copy this file to:
//
//     src/config/WifiCredentials.local.h
//
// and fill in your own network. The copy is gitignored and must never be
// committed; this template is committed and must never contain a real
// passphrase.
//
//     cp src/config/WifiCredentials.local.h.example \
//        src/config/WifiCredentials.local.h
//
// With no such file the firmware still builds and boots — it simply reports
// WIFI state=INACTIVE fault=NO_CREDENTIALS and never starts the radio.
//
// The #ifndef guards let a -DMATDOG_WIFI_SSID build flag take precedence
// (see src/config/WifiCredentials.h for the full resolution order).

#ifndef MATDOG_WIFI_SSID
#define MATDOG_WIFI_SSID "YOUR_2G4_SSID_HERE"
#endif

#ifndef MATDOG_WIFI_PASSWORD
#define MATDOG_WIFI_PASSWORD "YOUR_PASSPHRASE_HERE"
#endif
