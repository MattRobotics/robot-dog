-// uxTaskGetSystemState per armed release (scheduler suspended while it reads).
-inline uint32_t otherTasksUs(){static TaskStatus_t task[40];const UBaseType_t n=uxTaskGetSystemState(task,40,nullptr);
-  const TaskHandle_t self=xTaskGetCurrentTaskHandle();const BaseType_t core=xPortGetCoreID();uint32_t sum=0;
-  for(UBaseType_t i=0;i<n;++i)if(task[i].xHandle!=self&&(task[i].xCoreID==core||task[i].xCoreID==tskNO_AFFINITY))sum+=task[i].ulRunTimeCounter;
-  return sum;}
+// is the Motion task's time including the ISRs that interrupted it.
+// dev.8 P0: uxTaskGetSystemState also scans every task's free stack (vTaskGetInfo
+// with xGetFreeStackSpace): ~270k instructions per release in QEMU, a release
+// perturbation of the order measured. The tasks that can run on the Motion
+// core are now listed once per command (arm(), outside every release); a
+// release reads only their counters (vTaskGetInfo without the stack scan). A
+// task created after the command's arm() is not counted. arm() runs in the
+// Motion (loop) task: stand()/prone() from the USB router and from the HTTP
+// mailbox, both serviced by the loop. Tasks pinned to the Motion core come
+// first (their sum is exact); tasks without affinity (e.g. the FreeRTOS timer
+// service) follow and may have run on the other core (upper bound).
+inline TaskHandle_t coreTasks[16]{};inline unsigned coreTaskCount=0,pinnedTaskCount=0;
+inline void listCoreTasks(){static TaskStatus_t task[40];const UBaseType_t n=uxTaskGetSystemState(task,40,nullptr);
+  const TaskHandle_t self=xTaskGetCurrentTaskHandle();const BaseType_t core=xPortGetCoreID();coreTaskCount=0;
+  for(UBaseType_t i=0;i<n&&coreTaskCount<16;++i)if(task[i].xHandle!=self&&task[i].xCoreID==core)coreTasks[coreTaskCount++]=task[i].xHandle;
+  pinnedTaskCount=coreTaskCount;
+  for(UBaseType_t i=0;i<n&&coreTaskCount<16;++i)if(task[i].xHandle!=self&&task[i].xCoreID==tskNO_AFFINITY)coreTasks[coreTaskCount++]=task[i].xHandle;}
+struct OtherTasks { uint32_t all=0,pinned=0; };
+inline OtherTasks otherTasksUs(){OtherTasks o;TaskStatus_t t;
+  for(unsigned i=0;i<coreTaskCount;++i){vTaskGetInfo(coreTasks[i],&t,pdFALSE,eReady);o.all+=t.ulRunTimeCounter;if(i<pinnedTaskCount)o.pinned+=t.ulRunTimeCounter;}
+  return o;}
+#endif
+#ifdef MATDOG_DIAG_PMU
+// DIAGNOSTIC BUILD ONLY (dev.8 P0 timing, 2026-11-12), never the operational
+// candidate: what the Motion core does during a release's WALL time. CCOUNT
+// (core cycles, always on) against esp_timer gives the real clock. The two
+// Xtensa performance counters of this core are reprogrammed at every release
+// start, one group per release in a 7-release rotation: coprime with the T2
+// alternation (2), the control read (6), the joystick refresh (12 releases)
+// and the 500 ms IMU print whose USB interrupt lands on this core (25), so
+// no periodic load stays in one group.
+// Counting filter (PMCTRL, ESP-IDF xtensa_perfmon_exec semantics): KRNLCNT 0 +
+// TRACELEVEL 15 counts at every interrupt level, ISRs and other tasks
+// included (their time: otherTasksUs above); KRNLCNT 1 + TRACELEVEL 0 counts
+// only above level 0: ISRs, exception handlers (window spills run at EXCM
+// level) and critical sections. Group 0's cycles at every level must equal
+// CCOUNT: the self-check of the configuration on the device. Sums since boot
+// per class (WALK, its recovery after STOP, every other phase) and the
+// heaviest release of each class; read by @MOTION TIMING, never in a release.
+// Cost: 5 ERI writes per release, 3 reads per section switch.
+struct PmuGroup { uint16_t select[2],mask[2];uint8_t kernel[2],level[2]; };
+inline constexpr PmuGroup kPmuGroups[]={
+  {{2,0},{0x8DFF,0x0001},{0,0},{15,15}},  // 0 instructions retired / cycles, every level
+  {{4,3},{0x01FF,0x01FE},{0,0},{15,15}},  // 1 instruction-side / data-side GlobalStall cycles, every level
+  {{4,4},{0x0077,0x0180},{0,0},{15,15}},  // 2 instruction stalls on memory (cache miss, RAM/ROM busy, PIF, external, uncached, L32R) / on iterative mul+div
+  {{3,6},{0x01F8,0x01FD},{0,0},{15,15}},  // 3 data stalls on memory (cache miss, busy, PIF, MHT, uncached, bank) / pipeline bubbles
+  {{5,5},{0x0006,0x0020},{0,0},{15,15}},  // 4 interrupts taken (level 1 and above) / window exceptions
+  {{0,2},{0x0001,0x8DFF},{1,1},{0,0}},    // 5 cycles / instructions ABOVE level 0 (ISRs, exception handlers, critical sections)
+  {{4,3},{0x01FF,0x01FE},{1,1},{0,0}}};   // 6 instruction / data stalls ABOVE level 0
+constexpr unsigned kPmuGroups_=sizeof(kPmuGroups)/sizeof(kPmuGroups[0]);
+enum PmuClass : unsigned { PMU_WALK, PMU_RECOVERY, PMU_OTHER, PMU_CLASSES };
+constexpr unsigned kPmuParts[3]={NOMINAL,COMPENSATE,CONVERT};  // per-section sums kept for these
+// Per class and group: releases, wall us, other tasks us (all, pinned), then
+// [CCOUNT, counter 0, counter 1] of the whole release, then [us, CCOUNT,
+// counter 0, counter 1] of each of kPmuParts.
+constexpr unsigned kPmuColumns=4+3+4*3;
+struct PmuSample { uint32_t cc,pm[2]; };
+inline PmuSample pmuRead(){return {xthal_get_ccount(),{xtensa_perfmon_value(0),xtensa_perfmon_value(1)}};}
+inline void pmuArm(unsigned g){const auto& p=kPmuGroups[g];xtensa_perfmon_stop();
+  for(int i=0;i<2;++i)xtensa_perfmon_init(i,p.select[i],p.mask[i],p.kernel[i],p.level[i]);xtensa_perfmon_start();}
 #endif
 inline uint32_t overrunsTotal=0;  // since boot, never re-armed
