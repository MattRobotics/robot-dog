-  uint32_t otherTasksUs=0;  // other tasks of the core inside this release (diagnostic build)
+  uint32_t otherTasksUs=0,otherPinnedUs=0;  // other tasks of the core inside this release: all / pinned to it (diagnostic build)
+#endif
+#ifdef MATDOG_DIAG_PMU
