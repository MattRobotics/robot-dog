@@ -84,6 +86,9 @@ DalyKeyWriteGate DalyBms::requestKeyLogicDischarge(core::OperatingMode mode) {
 // KEY write); scripts/static_audit.py requires this to be the only
 // bms_uart_ write in the firmware.
 void DalyBms::startTransaction(DalyRequest request) {
+  // D2: the period that ends with this request is published as it is.
+  line_diag_ = line_live_;
+  line_live_ = LineDiag{};
   // Bounded stale drain. This UART has one owner and no queued TX: update()
   // checks room for the complete eight-byte frame before selecting it.
   size_t n = 0;
@@ -144,7 +149,26 @@ void DalyBms::handleKeyLogicWriteResponse() {
   key_write_readback_due_ = true;
 }
 
+// D2: one load of UART2's status register (HardwareSerial(2) is UART_NUM_2).
+// Reading it has no effect on the FIFOs, the interrupts or the line.
+void DalyBms::sampleLine(uint32_t now_ms) {
+  uart_status_reg_t st;
+  st.val = UART2.status.val;
+  LineDiag& d = line_live_;
+  ++d.samples;
+  const bool rx = st.rxd;
+  if (!rx) ++d.rx_low;
+  if (rx != line_last_rx_) ++d.rx_edges;
+  line_last_rx_ = rx;
+  if (st.rxfifo_cnt) {
+    ++d.fifo_nonzero;
+    if (st.rxfifo_cnt > d.fifo_max) d.fifo_max = static_cast<uint16_t>(st.rxfifo_cnt);
+  }
+  if (!st.txd && st.txfifo_cnt == 0 && now_ms - bus_.sentMs() >= kLineTxQuietMs) ++d.tx_low_idle;
+}
+
 void DalyBms::update(uint32_t now_ms, core::OperatingMode mode) {
+  sampleLine(now_ms);
   if (!bus_.inFlight()) {
     if (bms_uart_.availableForWrite() < static_cast<int>(kDalyRequestLen)) return;
     // Last look before the one write can leave: every precondition again,
