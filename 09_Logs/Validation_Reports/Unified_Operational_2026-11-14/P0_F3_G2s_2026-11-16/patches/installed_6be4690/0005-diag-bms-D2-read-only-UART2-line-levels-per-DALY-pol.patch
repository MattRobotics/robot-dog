 using namespace matdog;
@@ -60,5 +61,17 @@ int main(){
  poll();response.back()^=1;reply(t+140,response.size());check(C::CRC_FAIL,129,140,0,1);response.back()^=1;
  poll();response[0]=0;crc();reply(t+140,response.size());check(C::BAD_HEADER,129,140,0,2);response[0]=0xd2;crc();
  assert(b.sample().sampled_at_ms==ok_stamp+4*2000+560&&power::motionPower(b.sample(),test_ms,true)==P::ALARM);
- std::puts("DALY_ASYNC PASS production scheduler/parser, no flush/wire wait, alarms retained, stale/persistent fail closed, wrap, TX backpressure; D1 silence/partial/late/invalid diagnostics, streak, no extra TX; hardware=false");
+ // D2: UART2 levels per poll period, published at the next request; the
+ // register is only read (the stub would keep any write) and no byte is added.
+ {auto& st=UART2.status;st.val=0;st.rxd=1;st.txd=1;const auto txD2=u.tx.size();
+  poll();const D::LineDiag before=b.lineDiag();(void)before;     // opens the period under test
+  run(t+5);st.txd=0;st.txfifo_cnt=1;run(t+6);                     // TX low while sending: not counted
+  st.txfifo_cnt=0;run(t+8);                                        // FIFO empty but < 12 ms after the request
+  run(t+20);run(t+30);st.txd=1;                                    // TX low and idle: 2 samples
+  st.rxd=0;run(t+40);run(t+50);run(t+60);st.rxd=1;run(t+70);       // RX held low 3 samples, 2 edges
+  st.rxfifo_cnt=5;run(t+80);st.rxfifo_cnt=9;run(t+90);st.rxfifo_cnt=0;run(t+751);
+  poll();const auto& l=b.lineDiag();
+  assert(l.samples==13&&l.rx_low==3&&l.rx_edges==2&&l.tx_low_idle==2&&l.fifo_nonzero==2&&l.fifo_max==9);
+  assert(u.tx.size()==txD2+16);run(t+751);}
+ std::puts("DALY_ASYNC PASS production scheduler/parser, no flush/wire wait, alarms retained, stale/persistent fail closed, wrap, TX backpressure; D1 silence/partial/late/invalid diagnostics, streak, no extra TX; D2 line levels per period, read only; hardware=false");
 }
