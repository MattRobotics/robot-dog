@@ -73,6 +73,24 @@ class DalyBms {
   };
   const TelemetryDiag& telemetryDiag() const { return telemetry_diag_; }
 
+  // D2 (2026-11-15, diagnostic candidate): the UART2 pin levels update()
+  // samples from the peripheral status register, read only (status.rxd,
+  // status.txd, status.rxfifo_cnt): no bus traffic, no register write.
+  // Counted per poll period (request to request); the last completed period
+  // is published. Nothing here feeds availability, health, LED or Motion
+  // power. Loop-rate snapshots of the ESP side only: they show sustained
+  // levels, never short pulses and never the RS485 bus beyond the bridge.
+  static constexpr uint32_t kLineTxQuietMs = 12;  // request on the wire (8.34 ms) + margin
+  struct LineDiag {
+    uint32_t samples = 0;
+    uint32_t rx_low = 0;        // RX level 0 (idle is 1)
+    uint32_t rx_edges = 0;      // RX level changes between consecutive samples
+    uint32_t tx_low_idle = 0;   // TX level 0, TX FIFO empty, >= kLineTxQuietMs after the request
+    uint32_t fifo_nonzero = 0;  // RX hardware FIFO not empty (bytes the driver has not taken yet)
+    uint16_t fifo_max = 0;
+  };
+  const LineDiag& lineDiag() const { return line_diag_; }
+
   // BLOCKED per handoff 8A.8 / CLAUDE_CODE_PROMPT "DALY write is BLOCKED
   // until verified". The specific K-Series write protocol (opcode, framing,
   // ACK semantics, KEY-vs-MOS precedence) has not been identified or bench
@@ -105,6 +123,7 @@ class DalyBms {
 
  private:
   void startTransaction(DalyRequest request);
+  void sampleLine(uint32_t now_ms);
   void finishTransaction();
   void handleTelemetryResponse();
   void handleKeyConfigResponse();
@@ -123,6 +142,8 @@ class DalyBms {
   uint32_t rx_first_ms_ = kNoByte;  // in-flight transaction
   uint16_t stale_bytes_ = 0;        // drained before the in-flight request
   TelemetryDiag telemetry_diag_;
+  LineDiag line_live_, line_diag_;  // D2: current period, last completed period
+  bool line_last_rx_ = true;
 
   DalyCommResult last_result_ = DalyCommResult::NEVER_POLLED;
   uint32_t last_result_ms_ = 0;
