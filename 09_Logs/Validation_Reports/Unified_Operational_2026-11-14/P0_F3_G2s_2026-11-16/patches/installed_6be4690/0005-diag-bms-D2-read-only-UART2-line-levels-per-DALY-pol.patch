index 0000000..9a407fa
--- /dev/null
+++ b/05_Firmware/MATDOG_Controller/scripts/tests/daly_async_stub/soc/uart_struct.h
@@ -0,0 +1,13 @@
+#pragma once
+// Host stand-in for the ESP32-S3 UART status register (D2 test): the same
+// field layout as soc/esp32s3/register/soc/uart_struct.h, a writable UART2.
+#include <cstdint>
+typedef union {
+  struct {
+    uint32_t rxfifo_cnt:10; uint32_t reserved_10:3; uint32_t dsrn:1; uint32_t ctsn:1; uint32_t rxd:1;
+    uint32_t txfifo_cnt:10; uint32_t reserved_26:3; uint32_t dtrn:1; uint32_t rtsn:1; uint32_t txd:1;
+  };
+  uint32_t val;
+} uart_status_reg_t;
+typedef struct { volatile uart_status_reg_t status; } uart_dev_t;
+inline uart_dev_t UART2{};
