@@ -231,7 +231,7 @@ bool differential(LegId leg,LegJointAngles q,Vector3 velocity,Vector3 accelerati
 Vector3 rotateBack(const BodyPose& b,Vector3 v){return {b.rotation[0][0]*v.x+b.rotation[1][0]*v.y,b.rotation[0][1]*v.x+b.rotation[1][1]*v.y,v.z};}
 Vector3 sub(Vector3 a,Vector3 b){return {a.x-b.x,a.y-b.y,a.z-b.z};}
 }
-MATDOG_MOTION_HOT bool validGaitParameters(const GaitParameters& p) {
+bool validGaitParameters(const GaitParameters& p) {
   const double values[]={p.heightM,p.liftM,p.duty,p.advanceXM,p.advanceYM,p.yawRad,p.swayXM,p.swayYM,p.startCycles,p.stopCycles,p.maxCondition,p.comShiftXM,p.swingRamp,p.swingRampEnd,p.settleCycles};
   for(double v:values)if(!std::isfinite(v))return false;
   return (p.type==GaitType::WALK||p.type==GaitType::TROT)&&p.heightM>0&&p.liftM>0&&p.duty<1&&
diff --git a/05_Firmware/MATDOG_Controller/src/motion/MotionHotPath.h b/05_Firmware/MATDOG_Controller/src/motion/MotionHotPath.h
index b363623..fc4fcd6 100644
--- a/05_Firmware/MATDOG_Controller/src/motion/MotionHotPath.h
+++ b/05_Firmware/MATDOG_Controller/src/motion/MotionHotPath.h
@@ -20,6 +20,11 @@
 // a86c680 (16 KB 8-way LRU replay). Inline header functions (StopPlan::build,
 // jointSlot) cannot take the attribute: their literal pools keep a COMDAT section
 // the linker script places in flash (l32r "literal placed after use").
+//
+// G2s (16/11/2026, after the hardware MEMSTOP of cb9ed85): G2 without
+// contactInverseKinematicsGroundNormal and validGaitParameters, 17 functions and
+// 5 844 B of rig text instead of 9 966 B (-4.1 KB IRAM, +4 KB heap); replay: mean
+// misses -26/-27/-28/-45/-28 % instead of -34/-34/-36/-71/-39 %.
 #if defined(ESP_PLATFORM)
 #define MATDOG_MOTION_HOT __attribute__((section(".iram1.motion_hot")))
 #else
diff --git a/05_Firmware/MATDOG_Controller/src/motion/TiltedContactIk.cpp b/05_Firmware/MATDOG_Controller/src/motion/TiltedContactIk.cpp
index 888336f..d7c2e24 100644
--- a/05_Firmware/MATDOG_Controller/src/motion/TiltedContactIk.cpp
+++ b/05_Firmware/MATDOG_Controller/src/motion/TiltedContactIk.cpp
@@ -96,7 +96,7 @@ bool contactReferenceJacobian(LegId leg,const LegJointAngles& q,Vector3 normal,
   if(!finite(normal)||!finiteQ(q)||!std::isfinite(length)||length<=1e-12)return false;
   return contactJacobian(leg,q,scale(normal,1.0/length),contact,J);
 }
-MATDOG_MOTION_HOT TiltedIkResult contactInverseKinematicsGroundNormal(LegId leg, const Vector3& target, const Vector3& normal, const TiltedIkOptions& o) {
+TiltedIkResult contactInverseKinematicsGroundNormal(LegId leg, const Vector3& target, const Vector3& normal, const TiltedIkOptions& o) {
   TiltedIkResult out;
   if (!legModel(leg) || !finite(target) || !finite(normal) || !finiteQ(o.seed) || !(o.toleranceM > 0) || o.maxIterations == 0) return out;
   const double nl = norm(normal);
