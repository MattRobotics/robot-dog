+// Motion release cost, offline (dev.15). Production SimpleMotion on the scripted
+// rig of test_simple_motion.cpp with a constant tilted IMU (compensation active):
+// HOLD100, WALK45, WALK60, a steered combined walk. Counts per Motion release
+// (SimpleMotion::update only; cooperative telemetry excluded): libm
+// transcendental/sqrt calls through link-time wrappers (opcount.c, soft-double
+// cost proxy for the ESP32-S3) and the firmware's own work counters. Host wall
+// time is reported only as a relative figure, NOT ESP32-S3 timing.
+// Build: run_motion_cost_probe.sh.
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wreturn-type"
+#define main simple_motion_main
+#include "../tests/test_simple_motion.cpp"
+#undef main
+#pragma GCC diagnostic pop
+#include <chrono>
+#include "../../src/simple/MotionTiming.h"
+#include "../../src/simple/RcaProbe.h"
+#include <map>
+extern "C" { extern uint64_t op_trig,op_inv,op_sqrt; }
+namespace {
+struct Stat {
+  Stat(){for(int i=0;i<rca::NF;++i){rca::ns[i]=0;rca::calls[i]=0;}rca::stopIter=rca::stopJointChecks=0;}
+  std::vector<double> us,trig,inv,sq,iters;uint32_t work[simple::timing::WORKS]{};
+  void release(Rig& r){r.p.now+=simple::kPeriodUs;r.in.imuStampUs=r.p.now;r.m.inputs(r.in);r.p.publishCommandedPose();test_clock_us=r.p.now;
+    const uint64_t t0=op_trig,i0=op_inv,s0=op_sqrt;const auto a=std::chrono::steady_clock::now();
+    const uint64_t si0=rca::stopIter;
+    r.m.update(r.p.now);
+    iters.push_back(double(rca::stopIter-si0));
+    us.push_back(std::chrono::duration<double,std::micro>(std::chrono::steady_clock::now()-a).count());
+    trig.push_back(double(op_trig-t0));inv.push_back(double(op_inv-i0));sq.push_back(double(op_sqrt-s0));
+    const auto& w=simple::timing::state.previousWork;for(unsigned i=0;i<simple::timing::WORKS;++i)work[i]=std::max(work[i],w[i]);
+    r.m.updateTelemetry(r.p.now);}
+  static double mean(const std::vector<double>& v){double s=0;for(double x:v)s+=x;return s/v.size();}
+  static double max(const std::vector<double>& v){return *std::max_element(v.begin(),v.end());}
+  void print(const char* name){
+    std::map<int,int> h;for(double x:iters)h[int(x)]++;std::printf("  stopplan iterations/release mean=%.1f max=%.0f hist:",mean(iters),max(iters));for(auto&kv:h)std::printf(" %d:%d",kv.first,kv.second);std::printf("\n");
+    double tot=0;for(int i=0;i<rca::NF;++i)tot+=0;
+    for(int i=0;i<rca::NF;++i)std::printf("  %-20s calls/release=%6.2f host_ns/release=%8.0f\n",rca::names[i],double(rca::calls[i])/us.size(),rca::ns[i]/us.size());
+    std::printf("  stop joint-checks/release=%.1f\n",double(rca::stopJointChecks)/us.size());
+    for(int i=0;i<rca::NF;++i){rca::ns[i]=0;rca::calls[i]=0;}rca::stopIter=rca::stopJointChecks=0;
+    std::printf("%-16s n=%4zu trig mean/max=%6.1f/%4.0f  inv-trig=%5.1f/%3.0f  sqrt=%6.1f/%4.0f | host_us mean=%5.1f max=%6.1f | work max solves=%u ik=%u newton=%u fk=%u\n",
+      name,us.size(),mean(trig),max(trig),mean(inv),max(inv),mean(sq),max(sq),mean(us),max(us),
+      work[simple::timing::SOLVES],work[simple::timing::IK],work[simple::timing::NEWTON],work[simple::timing::FK]);}};
+void tilt(Rig& r,double roll,double pitch){  // constant board tilt seen by the IMU
+  const double cr=std::cos(roll/2),sr=std::sin(roll/2),cp=std::cos(pitch/2),sp=std::sin(pitch/2);
+  r.in.quaternion[0]=cr*cp;r.in.quaternion[1]=sr*cp;r.in.quaternion[2]=cr*sp;r.in.quaternion[3]=-sr*sp;}
+}
+int main(){
+  constexpr double degree=3.14159265358979323846/180;
+  {Rig r;assert(!r.m.stand(.10,r.p.now));assert(r.reachStand());tilt(r,.8*degree,1.2*degree);Stat s;
+    for(unsigned n=0;n<650;++n)s.release(r);s.print("HOLD100 tilted");}
+  for(unsigned stride:{1u,2u}){Rig r;assert(!r.m.stand(.15,r.p.now));assert(r.reachStand());assert(!r.m.walk(stride,r.p.now));
+    for(unsigned n=0;n<3000&&r.m.state()!=simple::State::WALKING;++n)r.tick();tilt(r,.3*degree,.8*degree);Stat s;
+    for(unsigned n=0;n<975;++n)s.release(r);assert(r.m.state()==simple::State::WALKING);s.print(stride==1?"WALK45 tilted":"WALK60 tilted");}
+  {Rig r;assert(!r.m.stand(.15,r.p.now));assert(r.reachStand());const double T=simple::kWalkPeriodS,v[3]={.5*simple::kJoystickStrideM/T,.5*simple::kJoystickLateralM/T,.5*simple::kJoystickYawRad/T};
+    for(unsigned n=0;n<3000&&r.m.state()!=simple::State::WALKING;++n){if(n%12==0)r.m.drive(v[0],v[1],v[2],r.p.now);r.tick();}
+    tilt(r,.3*degree,.8*degree);Stat s;for(unsigned n=0;n<975;++n){if(n%12==0)r.m.drive(v[0],v[1],v[2],r.p.now);s.release(r);}
+    assert(r.m.state()==simple::State::WALKING);s.print("JOYSTICK tilted");}
+
+  for(double target:{.05,.10,.15,.24}){Rig r;assert(!r.m.stand(.10,r.p.now));assert(r.reachStand());Stat s;
+    // board tilt ramping in pitch from 0 to `target` over 6 s, then held 7 s (tilted-table test shape)
+    for(unsigned n=0;n<650;++n){const double p=std::fmin(1.,n/300.)*target;tilt(r,.1*degree,p);s.release(r);}
+    char name[48];std::snprintf(name,sizeof name,"HOLD100 ramp %.2f",target);s.print(name);
+    std::vector<std::pair<double,double>> v;for(size_t i=0;i<s.us.size();++i)v.push_back({s.iters[i],s.us[i]});
+    std::sort(v.begin(),v.end());double lo=0,hi=0;size_t nl=0,nh=0;for(auto&x:v){if(x.first<=2){lo+=x.second;++nl;}else if(x.first>=20){hi+=x.second;++nh;}}
+    std::printf("  host_us mean when stopplan iters<=2: %.1f (n=%zu)   when iters>=20: %.1f (n=%zu)\n",nl?lo/nl:0,nl,nh?hi/nh:0,nh);}
