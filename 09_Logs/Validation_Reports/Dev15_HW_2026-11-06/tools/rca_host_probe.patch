+enum F { STOPPLAN, CSAFE, CTARGET, SUPPORTFIT, SOLVEGAIT, POINTSAFE, NF };
+inline const char* names[NF]={"StopPlan::build","compensationSafe","compensationTarget","supportLevelTarget","solveGait","pointSafe"};
+inline double ns[NF]{}; inline uint64_t calls[NF]{}; inline uint64_t stopIter=0, stopJointChecks=0;
+inline int depth[NF]{};
+struct T { F f; std::chrono::steady_clock::time_point a; bool top;
+  T(F x):f(x),a(std::chrono::steady_clock::now()),top(depth[x]++==0){++calls[x];}
+  ~T(){--depth[f]; if(top) ns[f]+=std::chrono::duration<double,std::nano>(std::chrono::steady_clock::now()-a).count();} };
+}
