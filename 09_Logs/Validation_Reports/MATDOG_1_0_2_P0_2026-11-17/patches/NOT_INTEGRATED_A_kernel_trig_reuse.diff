diff -ru a/src/motion/FootContact.cpp b/src/motion/FootContact.cpp
--- a/src/motion/FootContact.cpp	2026-11-16 21:18:36.100521643 +0100
+++ b/src/motion/FootContact.cpp	2026-11-17 10:31:21.390302934 +0100
@@ -48,6 +48,7 @@
   const auto fk = forwardKinematics(leg, q);
   result.status = convert(fk.status);
   if (fk.status != KinematicsStatus::OK) return result;
+  result.sinHip = fk.sinHip; result.cosHip = fk.cosHip; result.sinUpper = fk.sinUpper; result.cosUpper = fk.cosUpper;
   const auto& m = footContactModel();
   result.cylinderAxis = rotate(fk.baseFromFootRotation, m.axisInFoot);
   result.cylinderAxis = scale(result.cylinderAxis, 1.0/norm(result.cylinderAxis));
diff -ru a/src/motion/FootContact.h b/src/motion/FootContact.h
--- a/src/motion/FootContact.h	2026-11-14 09:57:23.217582269 +0100
+++ b/src/motion/FootContact.h	2026-11-17 10:31:21.390142967 +0100
@@ -31,6 +31,8 @@
   // cylinder the lowest support-strip endpoint is a different point.
   Vector3 referenceM{}, stripEndAM{}, stripEndBM{}, lowestCoreM{};
   double axisTiltRad = 0.0;
+  // From the FK at these joints (FkResult), reused by the contact Jacobian.
+  double sinHip = 0.0, cosHip = 0.0, sinUpper = 0.0, cosUpper = 0.0;
 };
 // Every output is in base_link. The supplied ground normal is normalized.
 // No assumption that the reference equals foot_link or lies on a ground plane.
diff -ru a/src/motion/LegKinematics.cpp b/src/motion/LegKinematics.cpp
--- a/src/motion/LegKinematics.cpp	2026-11-16 21:18:36.101521661 +0100
+++ b/src/motion/LegKinematics.cpp	2026-11-17 10:31:21.389982060 +0100
@@ -53,6 +53,7 @@
   for (unsigned r = 0; r < 3; ++r)
     for (unsigned c = 0; c < 3; ++c)
       result.baseFromFootRotation[r][c] = rotation[r][c];
+  result.sinHip = sh; result.cosHip = ch; result.sinUpper = su; result.cosUpper = cu;
   result.status = KinematicsStatus::OK;
   return result;
 }
diff -ru a/src/motion/LegKinematics.h b/src/motion/LegKinematics.h
--- a/src/motion/LegKinematics.h	2026-11-14 09:57:23.222582332 +0100
+++ b/src/motion/LegKinematics.h	2026-11-17 10:31:21.389763938 +0100
@@ -31,6 +31,9 @@
   KinematicsStatus status = KinematicsStatus::INVALID_INPUT;
   Vector3 footOriginM{};
   double baseFromFootRotation[3][3]{};
+  // sin/cos of q.hip and q.upper computed by this FK, for the contact Jacobian
+  // at the same q (the same four calls, not repeated).
+  double sinHip = 0.0, cosHip = 0.0, sinUpper = 0.0, cosUpper = 0.0;
 };
 
 // FK always enforces the canonical URDF limits (not operational safety limits).
diff -ru a/src/motion/TiltedContactIk.cpp b/src/motion/TiltedContactIk.cpp
--- a/src/motion/TiltedContactIk.cpp	2026-11-16 21:18:36.102473434 +0100
+++ b/src/motion/TiltedContactIk.cpp	2026-11-17 10:31:21.390478456 +0100
@@ -57,8 +57,9 @@
     const double qj = get(q, j);
     if (qj-h < m->limits[j].lower || qj+h > m->limits[j].upper) return false;
   }
-  const double sh = std::sin(q.hip), ch = std::cos(q.hip);
-  const double su = std::sin(q.upper), cu = std::cos(q.upper);
+  // c is the contact FK at this q: the same sin/cos of the same angles.
+  const double sh = c.sinHip, ch = c.cosHip;
+  const double su = c.sinUpper, cu = c.cosUpper;
   const Vector3 hip = m->hipOrigin;
   const Vector3 u = m->upperOrigin;
   const Vector3 upper = add(hip, {u.x, ch*u.y-sh*u.z, sh*u.y+ch*u.z});
