+    }
+    let corridor = lf_participant_corridor(motor_id)?;
+    if !corridor.contains(observation.position) || !corridor.contains(target_tick) {
+        return Err(format!(
+            "active M{motor_id} left commanded corridor: present={}, target={target_tick}, allowed={}..={}",
