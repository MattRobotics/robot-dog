+#[cfg(test)]
+fn position_inside_adaptive_contact_acceptance(
+    profile: &ContactProfile,
+    coarse_scout_tick: u16,
+    position: u16,
+) -> bool {
+    let (low, high) = adaptive_contact_acceptance_bounds(profile, Some(coarse_scout_tick));
+    (low..=high).contains(&position)
+}
