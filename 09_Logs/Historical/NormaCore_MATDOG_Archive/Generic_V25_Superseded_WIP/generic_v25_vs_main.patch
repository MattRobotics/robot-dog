+        let (mode, node) = self.session_motion_authority()?;
+        let joint = match node {
+            GoalNode::ReturnStaged { joint } => joint,
+            node => {
+                return Err(format!("W17/W18/W19 staged q0 is not reachable from {node:?}").into())
+            }
+        };
