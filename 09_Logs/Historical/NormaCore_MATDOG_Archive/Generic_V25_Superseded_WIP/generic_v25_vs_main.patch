+#[tokio::test]
+async fn done_completeness_is_enforced_at_runtime_for_every_mode() {
+    let probe = GoalWriteProbe::new("done-completeness").await;
+    for arm_value in [
+        LF_FULL_SEQUENCE_ARM_VALUE,
