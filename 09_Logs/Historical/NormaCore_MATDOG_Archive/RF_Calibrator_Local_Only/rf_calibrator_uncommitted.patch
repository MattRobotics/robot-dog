+fn rf_full_joint_corridor(motor_id: u8) -> Option<TickCorridor> {
+    let joint = match motor_id {
+        21 => Some(JointKind::Lower),
+        22 => Some(JointKind::Upper),
+        23 => Some(JointKind::Hip),
+        _ => None,
+    }?;
+    let minimum = build_profile(Leg::Rf, joint, ContactSide::Min).ok()?;
+    let maximum = build_profile(Leg::Rf, joint, ContactSide::Max).ok()?;
+    Some(TickCorridor {
+        low: minimum.guard_tick.min(maximum.guard_tick),
+        high: minimum
+            .guard_tick
+            .max(maximum.guard_tick)
+            .min(protocol::MAX_ANGLE_STEP),
+    })
+}
