+#[test]
+fn rf_witness_accepts_translated_pair_with_correct_span_not_absolute_ticks() {
+    // RF Upper, direction=-1: minimum=2600, maximum=2600-2004=596 (span
+    // exactly 2004, the LF V25 hardware-measured span), both inside the RF
+    // Upper generic corridors, but far from LF's own absolute contact ticks
+    // (1443/3442) and not mirrored around HOME=2048 -- proves the witness
+    // compares SPAN, not absolute or mirrored endpoint ticks.
+    let spec = *spec_for(Leg::Rf, JointKind::Upper);
+    let contact = |tick| ContactResult {
+        coarse_scout_tick: tick,
+        first_tick: tick,
+        second_tick: tick,
+        spread_ticks: 0,
+        baseline: BaselineStats {
+            median_current: 1,
+            mad_current: 0,
+        },
+    };
+    let contacts = DualContactResult {
+        minimum: contact(2600),
+        maximum: contact(596),
+    };
+    let evidence = derive_rf_joint_evidence(spec, contacts);
+    assert_eq!(evidence.affine.measured_span_ticks, 2004);
+    assert!(evidence.contact_witness_accepted);
+}
