+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum RfSessionState {
+    Preflight,
+    InitialRecovery,
+    Parking,
+    UpperMin,
+    UpperMax,
+    UpperHorizontal,
+    LowerMin,
+    LowerMax,
+    LowerFolded,
+    // Physical execution order for RF HIP M23 is reversed from LF: MAX
+    // (probe_sign<0, tick decrescenti) is the real first physical contact
+    // (downward); MIN (probe_sign>0, tick crescenti) is the real second
+    // physical contact (upward). These two state names track physical
+    // order; rf_contact_state() below is the only place that maps them to
+    // the logical ContactSide::{Min,Max} defined by build_profile().
+    HipDown,
+    HipUp,
+    Diagnostics,
+    ReturnHip,
+    ReturnLowerHeld,
+    ReturnUpper,
+    RestoreParking,
+    Cleanup,
+    TorqueOff,
+}
+
+impl RfSessionState {
+    const fn label(self) -> &'static str {
+        match self {
+            Self::Preflight => "preflight",
+            Self::InitialRecovery => "initial-recovery",
+            Self::Parking => "parking",
+            Self::UpperMin => "upper-min",
+            Self::UpperMax => "upper-max",
+            Self::UpperHorizontal => "upper-horizontal",
+            Self::LowerMin => "lower-min",
+            Self::LowerMax => "lower-max",
+            Self::LowerFolded => "lower-folded",
+            Self::HipDown => "hip-down",
+            Self::HipUp => "hip-up",
+            Self::Diagnostics => "diagnostics",
+            Self::ReturnHip => "return-hip",
+            Self::ReturnLowerHeld => "return-lower-held",
+            Self::ReturnUpper => "return-upper",
+            Self::RestoreParking => "restore-parking",
+            Self::Cleanup => "cleanup",
+            Self::TorqueOff => "torque-off",
+        }
+    }
+}
+
+#[derive(Debug, Clone)]
+struct RfSessionStateMachine {
+    state: RfSessionState,
+    active: Option<LfActiveMotor>,
+    held_targets: Vec<StaticTarget>,
+    entry_positions: Vec<(u8, u16)>,
+    contacts: [Option<DualContactResult>; 3],
+    fixed_scale: [Option<ModelZeroEstimate>; 3],
+    affine: [Option<AffineJointCalibration>; 3],
+    trace: Vec<RfSessionState>,
+}
+
+impl RfSessionStateMachine {
+    fn new(entry_positions: Vec<(u8, u16)>) -> Result<Self, String> {
+        let ids = entry_positions
+            .iter()
+            .map(|(motor_id, _)| *motor_id)
+            .collect::<Vec<_>>();
+        if !is_exact_matdog_motor_set(&ids) {
+            return Err(
+                "RF state machine requires one entry position for every canonical ID".into(),
+            );
+        }
+        Ok(Self {
+            state: RfSessionState::Preflight,
+            active: None,
+            held_targets: Vec::new(),
+            entry_positions,
+            contacts: [None; 3],
+            fixed_scale: [None; 3],
+            affine: [None; 3],
+            trace: vec![RfSessionState::Preflight],
+        })
+    }
+
+    fn transition(&mut self, next: RfSessionState) -> Result<(), String> {
+        let allowed = self.state == next
+            || matches!(next, RfSessionState::Cleanup)
+            || matches!(
+                (self.state, next),
+                (RfSessionState::Preflight, RfSessionState::InitialRecovery)
+                    | (RfSessionState::InitialRecovery, RfSessionState::Parking)
+                    | (RfSessionState::Parking, RfSessionState::UpperMin)
+                    | (RfSessionState::UpperMin, RfSessionState::UpperMax)
+                    | (RfSessionState::UpperMax, RfSessionState::UpperHorizontal)
+                    | (RfSessionState::UpperHorizontal, RfSessionState::LowerMin)
+                    | (RfSessionState::LowerMin, RfSessionState::LowerMax)
+                    | (RfSessionState::LowerMax, RfSessionState::LowerFolded)
+                    | (RfSessionState::LowerFolded, RfSessionState::HipDown)
+                    | (RfSessionState::HipDown, RfSessionState::HipUp)
+                    | (RfSessionState::HipUp, RfSessionState::Diagnostics)
+                    | (RfSessionState::Diagnostics, RfSessionState::ReturnHip)
+                    | (RfSessionState::ReturnHip, RfSessionState::ReturnLowerHeld)
+                    | (RfSessionState::ReturnLowerHeld, RfSessionState::ReturnUpper)
+                    | (RfSessionState::ReturnUpper, RfSessionState::RestoreParking)
+                    | (RfSessionState::RestoreParking, RfSessionState::Cleanup)
+                    | (RfSessionState::Cleanup, RfSessionState::TorqueOff)
+            );
+        if !allowed {
+            return Err(format!(
+                "invalid RF state transition: {} -> {}",
+                self.state.label(),
+                next.label()
+            ));
+        }
+        if self.state != next && !matches!(next, RfSessionState::Cleanup) {
+            self.validate_transition_entry(next)?;
+        }
+        if self.state != next {
+            self.state = next;
+            if next != RfSessionState::Diagnostics {
+                self.active = None;
+            }
+            self.trace.push(next);
+        }
+        Ok(())
+    }
+
+    fn validate_transition_entry(&self, next: RfSessionState) -> Result<(), String> {
+        let required_holds: &[u8] = match next {
+            RfSessionState::Preflight
+            | RfSessionState::InitialRecovery
+            | RfSessionState::Parking
+            | RfSessionState::Cleanup
+            | RfSessionState::TorqueOff => &[],
+            RfSessionState::UpperMin
+            | RfSessionState::UpperMax
+            | RfSessionState::UpperHorizontal => &[32],
+            RfSessionState::LowerMin | RfSessionState::LowerMax | RfSessionState::LowerFolded => {
+                &[22, 32]
+            }
+            RfSessionState::HipDown
+            | RfSessionState::HipUp
+            | RfSessionState::Diagnostics
+            | RfSessionState::ReturnHip => &[21, 22, 32],
+            RfSessionState::ReturnLowerHeld
+            | RfSessionState::ReturnUpper
+            | RfSessionState::RestoreParking => &[21, 22, 23, 32],
+        };
+        let observed_holds = self
+            .held_targets
+            .iter()
+            .map(|target| target.motor_id)
+            .collect::<BTreeSet<_>>();
+        let expected_holds = required_holds.iter().copied().collect::<BTreeSet<_>>();
+        if observed_holds != expected_holds {
+            return Err(format!(
+                "RF transition {} -> {} has wrong held set: expected={expected_holds:?}, observed={observed_holds:?}",
+                self.state.label(),
+                next.label(),
+            ));
+        }
+
+        let required_previous_active = match (self.state, next) {
+            (RfSessionState::UpperMin, RfSessionState::UpperMax)
+            | (RfSessionState::UpperMax, RfSessionState::UpperHorizontal) => Some(22),
+            (RfSessionState::LowerMin, RfSessionState::LowerMax)
+            | (RfSessionState::LowerMax, RfSessionState::LowerFolded) => Some(21),
+            (RfSessionState::HipDown, RfSessionState::HipUp)
+            | (RfSessionState::HipUp, RfSessionState::Diagnostics)
+            | (RfSessionState::Diagnostics, RfSessionState::ReturnHip) => Some(23),
+            _ => None,
+        };
+        if let Some(required_motor) = required_previous_active {
+            if self.active.map(|active| active.motor_id) != Some(required_motor) {
+                return Err(format!(
+                    "RF transition {} -> {} requires active M{required_motor}",
+                    self.state.label(),
+                    next.label(),
+                ));
+            }
+        }
+        Ok(())
+    }
+
+    fn active_motor_allowed(&self, motor_id: u8) -> bool {
+        match self.state {
+            RfSessionState::InitialRecovery => matches!(motor_id, 21 | 22 | 23),
+            RfSessionState::Parking | RfSessionState::RestoreParking => motor_id == 32,
+            RfSessionState::UpperMin
