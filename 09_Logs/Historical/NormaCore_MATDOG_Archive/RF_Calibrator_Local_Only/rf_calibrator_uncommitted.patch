+#[test]
+fn rf_hip_physical_order_is_max_down_first_min_up_second() {
+    let hip_max = build_profile(Leg::Rf, JointKind::Hip, ContactSide::Max).unwrap();
+    let hip_min = build_profile(Leg::Rf, JointKind::Hip, ContactSide::Min).unwrap();
+    // MAX: tick decrescenti (probe_sign<0) = physically DOWN, per hardware
+    // evidence (M23 decrement encoder -> rf_hip_link downward); physically
+    // first.
+    assert!(hip_max.probe_sign < 0);
+    // MIN: tick crescenti (probe_sign>0) = physically UP; physically second.
+    assert!(hip_min.probe_sign > 0);
+    assert_eq!(
+        rf_contact_state(JointKind::Hip, ContactSide::Max),
+        RfSessionState::HipDown
+    );
+    assert_eq!(
+        rf_contact_state(JointKind::Hip, ContactSide::Min),
+        RfSessionState::HipUp
+    );
+}
