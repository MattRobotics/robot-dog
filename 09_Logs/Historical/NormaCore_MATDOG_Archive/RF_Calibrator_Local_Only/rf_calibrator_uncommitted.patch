+// RF relative-span witness: predicts the region for the second RF contact
+// from the first really-measured RF contact (anchor) plus the second side's
+// own physical direction and the authoritative LF V25 mechanical span, then
+// intersects with the existing geometric guard/corridor. Never widens that
+// corridor; an empty intersection is a hard conflict, not a fallback.
+fn rf_expected_second_contact_region(
+    anchor_tick: u16,
+    second_probe_sign: i8,
+    reference_span_ticks: u16,
+    generic_low: u16,
+    generic_high: u16,
+) -> Result<(u16, u16), String> {
+    let expected_second_tick = advance_tick(anchor_tick, second_probe_sign, reference_span_ticks)
+        .map_err(|err| {
+            format!(
+                "RF anchor+span prediction leaves unsigned tick range: anchor={anchor_tick}, span={reference_span_ticks}, sign={second_probe_sign}: {err}"
+            )
+        })?;
+    let raw_low = expected_second_tick.saturating_sub(RF_WITNESS_TOLERANCE_TICKS);
+    let raw_high = expected_second_tick
+        .saturating_add(RF_WITNESS_TOLERANCE_TICKS)
+        .min(protocol::MAX_ANGLE_STEP);
+    let region_low = raw_low.max(generic_low);
+    let region_high = raw_high.min(generic_high);
+    if region_low > region_high {
+        return Err(format!(
+            "RF anchor-region conflict: predicted region {raw_low}..={raw_high} \
+             (anchor={anchor_tick}, span={reference_span_ticks}, expected={expected_second_tick}) \
+             does not overlap geometric corridor {generic_low}..={generic_high}; requires \
+             prerequisite/corridor re-audit before searching the second contact"
+        ));
+    }
+    Ok((region_low, region_high))
