+fn rf_witness_deviation_24_accepts_25_rejects() {
+    let reference = rf_reference_span_ticks(JointKind::Hip); // 935, LF V25 hardware-measured
+    assert_eq!(reference, 935);
+    assert!(rf_contact_witness_accepted(reference, reference + 24));
+    assert!(!rf_contact_witness_accepted(reference, reference + 25));
+}
